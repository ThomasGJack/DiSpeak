# Backend Configuration
BACKEND_URL=http://localhost:8000
DATABASE_URL=sqlite:backend.db
# JWT signing (dev legacy HS256)
JWT_SECRET=your-secret-key-here
# Par defaut hors dev: RS256 si JWT_SIGNING_MODE non defini
# JWT_SIGNING_MODE=rs256
# JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
# JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
# JWT_KID=main-2026-01
OWNER_KEY_ENCRYPTION_KEY=ZmFrZS1kZXYtMzItYnl0ZS1rZXktcmVwbGFjZS1tZQ==
# BACKEND_ALLOW_INSECURE_OWNER_KEY_FALLBACK=false
PORT=8000
BACKEND_BIND_HOST=127.0.0.1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_HEALTHCHECK_TIMEOUT_MS=2000
SERVER_INTERNAL_API_TOKEN=change-me-internal-api-token
# Endpoints legacy runtime backend (deprecie) - laisser false hors dev
# BACKEND_ALLOW_REGISTER_AUTO_SYSTEM_SERVER=false
# BACKEND_ALLOW_LEGACY_HEARTBEAT_TOKEN=false

# Server Configuration
SERVER_URL=ws://localhost:8001
SERVER_DATABASE_URL=sqlite:server.db
SERVER_PORT=8001
SERVER_INTERNAL_API_HOST=127.0.0.1
# SERVER_INTERNAL_API_PORT=8002
SERVER_INTERNAL_API_TOKEN=change-me-internal-api-token
# OWNER_KEY=dso_xxxxx_xxxxxxxxx
# SERVER_ENFORCE_OWNER_VALIDATION=true
# SERVER_ALLOW_INSECURE_HTTP_BACKEND=false
# SERVER_ALLOW_LEGACY_HS256=false
# SERVER_ALLOW_LEGACY_RUNTIME_FLOW=false
# SERVER_BOOTSTRAP_TIMEOUT_MS=5000

# Frontend Configuration
VITE_BACKEND_URL=http://localhost:8000
VITE_SERVER_URL=ws://localhost:8001
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
