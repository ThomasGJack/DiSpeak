# Configuration du serveur DiSpeak
# ⚠️ Fallback legacy: préférez `server-config.toml` (voir `server/server-config.toml.example`)

# Base de données SQLite
DATABASE_URL=sqlite:server.db

# Port d'écoute WebSocket
SERVER_PORT=8001

# Adresse d'écoute
SERVER_HOST=127.0.0.1

# API HTTP interne (backend -> serveur temps réel)
# /health reste public, /api/* requiert un token Bearer
SERVER_INTERNAL_API_HOST=127.0.0.1
# SERVER_INTERNAL_API_PORT=8002
SERVER_INTERNAL_API_TOKEN=change-me-internal-api-token

# Heartbeat vers le backend (optionnel)
# Si configuré, le serveur signale sa présence au backend
# SERVER_ID=votre-server-id-uuid
# BACKEND_URL=http://localhost:8000
# AUTH_TOKEN=votre-jwt-token

# Nouveau workflow binaire distribué (recommandé, avec validation propriétaire)
# OWNER_KEY=dso_xxxxx_xxxxxxxxx
# SERVER_ENFORCE_OWNER_VALIDATION=true
# SERVER_BOOTSTRAP_TIMEOUT_MS=5000
# SERVER_ALLOW_INSECURE_HTTP_BACKEND=false
# SERVER_ALLOW_LEGACY_HS256=false
# SERVER_ALLOW_LEGACY_RUNTIME_FLOW=false
